# CMake script file to process a text file by wrapping every line in double quotes.
# Input file must not abuse quotes, staying with single quotes is probably best.
# note also empty lines cannot be stripped: they have a meaning (separator) in markdown
# so we use file( READ ... ) to read the full file content, including empty lines
#
# The output may live in the source tree, shared by several build directories that run this
# script at the same time: the text is built in memory, an identical file is only touched and a
# changed one is replaced atomically through a uniquely named temporary file in the same folder.

file( READ ${inputFile} buffer )

#Remark: strings can contain semicolon. a semicolon is a separation in cmake.
#so, to avoid stripping semicolon in variables we have to quote them

# Replace each "\" char by "\\". the \ is found in .md files
# to prepend some chars that are usually control chars
STRING( REPLACE "\\" "\\\\" linea "${buffer}" )

# Replace each " char by \"
STRING( REPLACE "\"" "\\\"" linem "${linea}" )

# Replace each EOL char by "\n" + " + EOL
STRING( REPLACE "\n" "\\n\"\n\"" buff_m "${linem}" )

# create the full string compatible "C":
# _HKI( "<md string>"\n
# to make it translatable. We use here the marker _HKI because
# the translation will be explicitely called in Kicad code
# Write the buffer between quotes
set( content "// Do not edit this file, it is autogenerated by CMake from the .md file\n" )
string( APPEND content "_HKI( \"" "${buff_m}" "\" );\n" )

function( md2c_matches out_var )
    set( ${out_var} FALSE PARENT_SCOPE )

    if( EXISTS "${outputFile}" AND NOT IS_DIRECTORY "${outputFile}" )
        file( READ "${outputFile}" existing )

        if( existing STREQUAL content )
            set( ${out_var} TRUE PARENT_SCOPE )
        endif()
    endif()
endfunction()

md2c_matches( same )

if( same )
    file( TOUCH "${outputFile}" )
    return()
endif()

get_filename_component( out_dir "${outputFile}" DIRECTORY )
get_filename_component( out_name "${outputFile}" NAME )

foreach( attempt RANGE 1 20 )
    string( RANDOM LENGTH 12 tag )
    string( TIMESTAMP stamp "%s%f" UTC )
    set( tmp_file "${out_dir}/.${out_name}.${stamp}.${tag}.tmp" )

    file( WRITE "${tmp_file}" "${content}" )
    file( RENAME "${tmp_file}" "${outputFile}" RESULT rename_result )

    if( rename_result EQUAL 0 )
        return()
    endif()

    file( REMOVE "${tmp_file}" )

    # A concurrent run may hold the file open (Windows); its content is what we want if it won.
    md2c_matches( same )

    if( same )
        return()
    endif()

    execute_process( COMMAND ${CMAKE_COMMAND} -E sleep 0.1 )
endforeach()

message( FATAL_ERROR "markdown2C: cannot replace ${outputFile}: ${rename_result}" )
